---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { name: string; alt: string; eager?: boolean; widths?: number[]; sizes?: string; class?: string }
const { name, alt, eager = false, widths = [720, 1200, 1800, 2400], sizes = '(min-width: 1100px) 60vw, 94vw', class: cls } = Astro.props;

const all = import.meta.glob<{ default: ImageMetadata }>('../assets/shots/*.png', { eager: true });
const hit = Object.entries(all).find(([p]) => p.endsWith(`/${name}.png`));
if (!hit) throw new Error(`Screenshot "${name}.png" is missing from src/assets/shots`);
const src = hit[1].default;
const usable = widths.filter((w) => w <= src.width);
---
<Image
  src={src}
  alt={alt}
  widths={usable.length ? usable : [src.width]}
  sizes={sizes}
  format="webp"
  quality={86}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
  decoding="async"
  class={cls}
/>
